SELECT
    c.column_id AS "SNO",
    c.column_name AS "FIELD NAME",

    CASE
        WHEN c.data_type IN ('CHAR', 'VARCHAR2', 'NCHAR', 'NVARCHAR2') THEN 'A'
        WHEN c.data_type = 'NUMBER' THEN 'N'
        WHEN c.data_type = 'DATE'
          OR c.data_type LIKE 'TIMESTAMP%' THEN 'T'
        ELSE c.data_type
    END AS "DATA TYPE",

    CASE
        WHEN c.data_type = 'NUMBER'
            THEN NVL(c.data_precision, c.data_length)
        WHEN c.data_type = 'DATE'
          OR c.data_type LIKE 'TIMESTAMP%'
            THEN 19
        ELSE c.data_length
    END AS "LENGTH",

    NVL(TO_CHAR(c.data_scale), '') AS "DECIMAL PRECISION",

    CASE
        WHEN pk.column_name IS NOT NULL THEN 'PK'
        WHEN fk.column_name IS NOT NULL THEN 'FK'
        ELSE ''
    END AS "KEY (FK, PK)",

    CASE
        WHEN c.nullable = 'N' THEN 'M'
        ELSE 'O'
    END AS "M/O",

    NVL(cc.comments, '') AS "FIELD DESCRIPTION",

    CASE
        WHEN c.data_type = 'DATE'
          OR c.data_type LIKE 'TIMESTAMP%'
        THEN 'YYYY-MM-DD HH24:MI:SS'
        ELSE ''
    END AS "DATE FORMAT",

    '' AS "DEFAULT VALUE",
    '' AS "REMARKS",
    '' AS "PII",

    da.sqlname_c AS "Source Data Type",
    dd.DEF_MAX_DB_LEN_N AS "Source Length"
     
FROM all_tab_columns c

LEFT JOIN all_col_comments cc
       ON c.owner = cc.owner
      AND c.table_name = cc.table_name
      AND c.column_name = cc.column_name

LEFT JOIN (
    SELECT acc.owner,
           acc.table_name,
           acc.column_name
    FROM all_cons_columns acc
    JOIN all_constraints ac
      ON acc.owner = ac.owner
     AND acc.constraint_name = ac.constraint_name
    WHERE ac.constraint_type = 'P'
) pk
    ON c.owner = pk.owner
   AND c.table_name = pk.table_name
   AND c.column_name = pk.column_name

LEFT JOIN (
    SELECT acc.owner,
           acc.table_name,
           acc.column_name
    FROM all_cons_columns acc
    JOIN all_constraints ac
      ON acc.owner = ac.owner
     AND acc.constraint_name = ac.constraint_name
    WHERE ac.constraint_type = 'R'
) fk
    ON c.owner = fk.owner
   AND c.table_name = fk.table_name
   AND c.column_name = fk.column_name

LEFT JOIN AAAMAINDB.dict_entity de
       ON UPPER(de.sqlname_c) = c.table_name

LEFT JOIN AAAMAINDB.dict_attribute da
       ON da.entity_dict_id = de.dict_id
      AND UPPER(da.sqlname_c) = c.column_name

LEFT JOIN AAAMAINDB.dict_datatype dd
       ON dd.dict_id = da.datatype_dict_id

WHERE c.owner = 'AAAMAINDB'
  AND c.table_name = 'UDT_DOC_DEFI'

ORDER BY c.column_id;
