import java.sql.*;
import java.util.*;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

public class RuleAnalyzer {

    private final Connection conn;

    public RuleAnalyzer(Connection conn) {
        this.conn = conn;
    }

    public void analyzeScreen(String screenName) throws Exception {

        String mainSql =
            "SELECT DISTINCT da.sqlname_c " +
            "FROM script_definition sd " +
            "INNER JOIN dict_attribute da " +
            "ON da.dict_id = sd.attribute_dict_id " +
            "WHERE sd.object_id IN " +
            "(SELECT dict_id FROM dict_screen WHERE name = ?)";

        try (PreparedStatement ps = conn.prepareStatement(mainSql)) {

            ps.setString(1, screenName);

            ResultSet rs = ps.executeQuery();

            while (rs.next()) {

                String attributeName = rs.getString("sqlname_c");

                String definition = getDefinition(attributeName, screenName);

                if (definition == null || definition.isEmpty()) {
                    continue;
                }

                // Remove {...}
                definition = removeCurlyBraces(definition);

                System.out.println("--------------------------------");
                System.out.println("ATTRIBUTE : " + attributeName);

                Set<String> dependencies =
                    extractSourceFields(definition);

                System.out.println("DEPENDENCIES:");

                for (String dep : dependencies) {
                    System.out.println("  " + dep);
                }
            }
        }
    }

    private String getDefinition(
            String attributeName,
            String screenName) throws SQLException {

        String sql =
        """
        WITH selected_nature AS (
            SELECT CASE
                     WHEN EXISTS (
                         SELECT 1
                         FROM script_definition sd
                         INNER JOIN dict_attribute da
                             ON da.dict_id = sd.attribute_dict_id
                         WHERE sd.object_id IN (
                                 SELECT dict_id
                                 FROM dict_screen
                                 WHERE name = ?
                               )
                           AND da.sqlname_c = ?
                           AND sd.nature_e = 10
                     ) THEN 10

                     WHEN EXISTS (
                         SELECT 1
                         FROM script_definition sd
                         INNER JOIN dict_attribute da
                             ON da.dict_id = sd.attribute_dict_id
                         WHERE sd.object_id IN (
                                 SELECT dict_id
                                 FROM dict_screen
                                 WHERE name = ?
                               )
                           AND da.sqlname_c = ?
                           AND sd.nature_e = 2
                     ) THEN 2

                     ELSE 1
                   END AS nature_e
            FROM dual
        )
        SELECT XMLCAST(
               XMLAGG(
                  XMLELEMENT(e, sd.definition_c || CHR(10))
                  ORDER BY sd.rank_n
               ) AS CLOB
               ) AS definition_c
        FROM script_definition sd
        INNER JOIN dict_attribute da
            ON da.dict_id = sd.attribute_dict_id
        INNER JOIN selected_nature sn
            ON sn.nature_e = sd.nature_e
        WHERE sd.object_id IN (
                SELECT dict_id
                FROM dict_screen
                WHERE name = ?
              )
          AND da.sqlname_c = ?
        """;

        try (PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setString(1, screenName);
            ps.setString(2, attributeName);

            ps.setString(3, screenName);
            ps.setString(4, attributeName);

            ps.setString(5, screenName);
            ps.setString(6, attributeName);

            ResultSet rs = ps.executeQuery();

            if (rs.next()) {
                return rs.getString(1);
            }
        }

        return null;
    }

    /**
     * Removes:
     * {xxxxx}
     */
    private String removeCurlyBraces(String text) {

        return text.replaceAll("\\{[^}]*\\}", "");
    }

    /**
     * Extracts:
     *
     * &portfolio_id = portfolio_id
     * &ref_curr_id.code = op_currency_id.code
     *
     * Returns:
     * portfolio_id
     * op_currency_id.code
     */
    private Set<String> extractSourceFields(String script) {

        Set<String> result = new LinkedHashSet<>();

        Pattern p = Pattern.compile(
            "&[A-Za-z0-9_\\.]+\\s*=\\s*([A-Za-z0-9_\\.]+)"
        );

        Matcher m = p.matcher(script);

        while (m.find()) {

            String sourceField = m.group(1);

            if (!sourceField.matches("\\d+")) {
                result.add(sourceField);
            }
        }

        return result;
    }
}
