
SELECT user_code, access_source, channel_code, channel_profile, profile_type, profile_code
FROM (
    SELECT au.code user_code, 'DIRECT_USER' access_source, 'GUI' channel_code, acp.code channel_profile, 'FUNCTION_SECURITY' profile_type, fsp.code profile_code
    FROM appl_user au LEFT JOIN appl_channel_profile acp ON acp.id = au.channel_profile_id LEFT JOIN func_secu_prof fsp ON fsp.id = au.func_secu_prof_id
 
    UNION ALL
    SELECT au.code, 'DIRECT_USER', 'GUI', acp.code, 'FORMAT', fp.code
    FROM appl_user au LEFT JOIN appl_channel_profile acp ON acp.id = au.channel_profile_id LEFT JOIN format_profile fp ON fp.id = au.format_profile_id
 
    UNION ALL
    SELECT au.code, 'DIRECT_USER', 'GUI', acp.code, 'REPORT', rp.code
    FROM appl_user au LEFT JOIN appl_channel_profile acp ON acp.id = au.channel_profile_id LEFT JOIN report_profile rp ON rp.id = au.report_profile_id
 
    UNION ALL
    SELECT au.code, 'DIRECT_USER', 'GUI', acp.code, 'SCREEN', sp.code
    FROM appl_user au LEFT JOIN appl_channel_profile acp ON acp.id = au.channel_profile_id LEFT JOIN screen_profile sp ON sp.id = au.screen_profile_id
 
    UNION ALL
    SELECT au.code, 'DIRECT_USER', 'GUI', acp.code, 'MENU', mp.code
    FROM appl_user au LEFT JOIN appl_channel_profile acp ON acp.id = au.channel_profile_id LEFT JOIN menu_profile mp ON mp.id = au.menu_profile_id
 
    UNION ALL
    SELECT au.code, 'DIRECT_USER', 'GUI', acp.code, 'DATA', dp.code
    FROM appl_user au LEFT JOIN appl_channel_profile acp ON acp.id = au.channel_profile_id LEFT JOIN data_profile dp ON dp.id = au.data_profile_id
 
    UNION ALL
    SELECT au.code, 'DIRECT_USER', 'GUI', acp.code, 'EXTERNAL_SERVICE', esp.code
    FROM appl_user au LEFT JOIN appl_channel_profile acp ON acp.id = au.channel_profile_id LEFT JOIN ext_service_profile esp ON esp.id = au.ext_service_prof_id
 
    UNION ALL
    SELECT au.code, 'CHANNEL_PROFILE', ac.code, acp.code, 'FUNCTION_SECURITY', fsp.code
    FROM appl_user au JOIN appl_channel_profile acp ON acp.id = au.channel_profile_id
    JOIN appl_channel_prof_compo acpc ON acpc.appl_channel_profile_id = acp.id
    LEFT JOIN appl_channel ac ON ac.id = acpc.appl_channel_id
    LEFT JOIN func_secu_prof fsp ON fsp.id = acpc.func_secu_prof_id
 
    UNION ALL
    SELECT au.code, 'CHANNEL_PROFILE', ac.code, acp.code, 'SCREEN', sp.code
    FROM appl_user au JOIN appl_channel_profile acp ON acp.id = au.channel_profile_id
    JOIN appl_channel_prof_compo acpc ON acpc.appl_channel_profile_id = acp.id
    LEFT JOIN appl_channel ac ON ac.id = acpc.appl_channel_id
    LEFT JOIN screen_profile sp ON sp.id = acpc.screen_profile_id
 
    UNION ALL
    SELECT au.code, 'CHANNEL_PROFILE', ac.code, acp.code, 'FORMAT', fp.code
    FROM appl_user au JOIN appl_channel_profile acp ON acp.id = au.channel_profile_id
    JOIN appl_channel_prof_compo acpc ON acpc.appl_channel_profile_id = acp.id
    LEFT JOIN appl_channel ac ON ac.id = acpc.appl_channel_id
    LEFT JOIN format_profile fp ON fp.id = acpc.format_profile_id
 
    UNION ALL
    SELECT au.code, 'CHANNEL_PROFILE', ac.code, acp.code, 'REPORT', rp.code
    FROM appl_user au JOIN appl_channel_profile acp ON acp.id = au.channel_profile_id
    JOIN appl_channel_prof_compo acpc ON acpc.appl_channel_profile_id = acp.id
    LEFT JOIN appl_channel ac ON ac.id = acpc.appl_channel_id
    LEFT JOIN report_profile rp ON rp.id = acpc.report_profile_id
 
    UNION ALL
    SELECT au.code, 'CHANNEL_PROFILE', ac.code, acp.code, 'MENU', mp.code
    FROM appl_user au JOIN appl_channel_profile acp ON acp.id = au.channel_profile_id
    JOIN appl_channel_prof_compo acpc ON acpc.appl_channel_profile_id = acp.id
    LEFT JOIN appl_channel ac ON ac.id = acpc.appl_channel_id
    LEFT JOIN menu_profile mp ON mp.id = acpc.menu_profile_id
 
    UNION ALL
    SELECT au.code, 'CHANNEL_PROFILE', ac.code, acp.code, 'EXTERNAL_SERVICE', esp.code
    FROM appl_user au JOIN appl_channel_profile acp ON acp.id = au.channel_profile_id
    JOIN appl_channel_prof_compo acpc ON acpc.appl_channel_profile_id = acp.id
    LEFT JOIN appl_channel ac ON ac.id = acpc.appl_channel_id
    LEFT JOIN ext_service_profile esp ON esp.id = acpc.ext_service_prof_id
)
WHERE profile_code IS NOT NULL
  AND user_code = :USER_CODE
ORDER BY user_code, access_source, channel_code, profile_type;
 
 
