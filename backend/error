Format Details: 
select f.code AS FORMAT_CODE, fe.sqlname_c as ELEMENT_CODE, fe.name as ELEMENT_NAME, fe.denom AS ELEMENT_DENOM, dd.sqlname_c AS ELEMENT_DATATYPE, fe.rank_n AS ELEMENT_RANK,
fe.display_column_n AS DISPLAY_COLUMN, fe.display_format_c as DISPLAY_FORMAT, fe.fixed_f AS FIXED_COULMN, fe.cons_f AS CONSOLIDATION, fe.sub_total_f AS SUB_TOTAL, fe.totaliser_c AS TOTALISER,
fe.col_width_n AS COLUMN_WIDTH
from format_element fe, format f, dict_datatype dd
where
fe.format_id = f.id
AND fe.datatype_dict_id = dd.dict_id
order by f.code, fe.rank_n; 
 
 
