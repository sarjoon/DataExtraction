WITH ranked_definitions AS (
    SELECT
        da.sqlname_c,
        sd.nature_e,
        sd.definition_c,
        sd.rank_n,
        DENSE_RANK() OVER (
            PARTITION BY da.sqlname_c
            ORDER BY CASE sd.nature_e
                WHEN 10 THEN 1
                WHEN 2  THEN 2
                WHEN 1  THEN 3
            END
        ) AS nature_priority
    FROM <SCHEMA>.script_definition sd
    JOIN <SCHEMA>.dict_attribute da
        ON da.dict_id = sd.attribute_dict_id
    WHERE sd.object_id IN (
        SELECT dict_id
        FROM <SCHEMA>.dict_screen
        WHERE name = :screen_name
    )
      AND sd.nature_e IN (10, 2, 1)
)
SELECT
    sqlname_c,
    nature_e,
    definition_c
FROM ranked_definitions
WHERE nature_priority = 1
ORDER BY
    sqlname_c,
    rank_n;