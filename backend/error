DATA
 
SELECT

    dp.code  AS DATA_PROFILE,

    dsp.code AS DATA_SECU_PROFILE,

    dpc.auth_update_f AS AUTH_UPDATE,

    dpc.auth_delete_f AS AUTH_DELETE

FROM data_profile dp

INNER JOIN data_prof_compo dpc

    ON dp.id = dpc.data_profile_id

INNER JOIN data_secu_prof dsp

    ON dsp.id = dpc.data_secu_prof_id

Order BY

    dp.code,

    dsp.code;
 
FUNCTION_SECURITY: 
SELECT

     fsp.code AS FSP_CODE,

     df.name AS FUNCTION,

     de.sqlname_c AS ENTITY,

     t1.code AS TYPE,

     t2.code AS SUBTYPE,

     dpv1.name AS MIN_STATUS,

     dpv2.name AS MAX_STATUS,

     fspc.create_f AS CREATE_FLAG,

     fspc.update_f AS UPDATE_FLAG,

     fspc.delete_f AS DELETE_FLAG,

     fspc.risk_view_f AS RISK_VIEW_FLAG,

     fspc.real_time_f AS REALTIME_FLAG,

     fspc.view_f AS VIEW_FLAG,

     fspc.visible_f AS VISIBLE_FLAG

FROM func_secu_prof fsp

INNER JOIN func_secu_prof_compo fspc

     ON fsp.id = fspc.func_secu_prof_id

LEFT JOIN dict_function df

     ON df.dict_id = fspc.function_dict_id

LEFT JOIN dict_entity de

     ON de.dict_id = fspc.entity_dict_id

LEFT JOIN type t1

     ON t1.id = fspc.type_id

LEFT JOIN type t2

     ON t2.id = fspc.subtype_id

LEFT JOIN dict_entity de_op

     ON de_op.sqlname_c = 'operation'

LEFT JOIN dict_attribute da_status

     ON da_status.entity_dict_id = de_op.dict_id

    AND da_status.sqlname_c = 'status_e'

LEFT JOIN dict_perm_value dpv1

     ON dpv1.attribute_dict_id = da_status.dict_id

    AND dpv1.perm_val_nat_e = fspc.min_status_e

LEFT JOIN dict_perm_value dpv2

     ON dpv2.attribute_dict_id = da_status.dict_id

    AND dpv2.perm_val_nat_e = fspc.max_status_e;
 
Format Profile:
select fp.code AS FORMAT_PROFILE, f.code AS FORMAT, f.name AS FORMAT_NAME, df.name AS FUNCTION, dpv.name AS NATURE, fpc.rank_n AS Rank
from format f, format_profile fp, format_prof_compo fpc, dict_function df, dict_attribute da, dict_perm_value dpv
where
fpc.format_id = f.id
AND fpc.format_profile_id = fp.id
AND df.dict_id = f.function_dict_id
AND f.nature_e = dpv.perm_val_nat_e
AND dpv.attribute_dict_id = da.dict_id
AND da.dict_id = (select dict_id from dict_attribute where sqlname_c = 'nature_e' AND entity_dict_id = (select dict_id from dict_entity where sqlname_c = 'format'))
order by fp.code, df.name, dpv.name, fpc.rank_n;
