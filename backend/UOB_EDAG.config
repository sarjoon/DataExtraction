#!/bin/ksh
######################################################################################
# UOB_EDAG.config
######################################################################################
# 
# 	Configuration File for EDAG Extraction                     
# 
#	Date			Name				Description
#	05-Mar-2019	Jonathan Au (N+P)		Initial Version
#	18-Apr-2019	Jonathan Au	(N+P)		Updated CD Transfer & Logging Directories
######################################################################################

# Maximum number of parallel extractions jobs running
MAX_PARALLEL_EXTRACTION_JOBS=15

# Working Directory
WORK_DIR=$PRODLIB/scripts/EDAG_Extraction/tmp
#WORK_DIR=$AAAHOME/tmp/EDAG/tmp

# Archive Directory
ARCHIVE_DIR=$PRODLIB/scripts/EDAG_Extraction/Archive

# Output Directory
OUTPUT_DIR=$PRODLIB/scripts/EDAG_Extraction/Output
#OUTPUT_DIR=$AAAHOME/tmp/EDAG/Output

# Config Directory
CONFIG_DIR=$PRODLIB/scripts/EDAG_Extraction/Config

# Extractor Directory
EXTRACT_DIR=$PRODLIB/scripts/EDAG_Extraction/Extractors

# List of entities to be extracted
EXTRACTION_ENTITIES_LIST=$PRODLIB/scripts/EDAG_Extraction/Config/EDAG_Extraction_Entities.txt
EXTRACTION_TAP_ENTITIES_LIST=$PRODLIB/scripts/EDAG_Extraction/Config/EDAG_Extraction_Entities_TAP.txt
EXTRACTION_CDM_ENTITIES_LIST=$PRODLIB/scripts/EDAG_Extraction/Config/EDAG_Extraction_Entities_CDM.txt

# List of Views
VIEWS_DIR=$PRODLIB/scripts/EDAG_Extraction/Setup/Views

# Log Directory
LOG_DIR=$PRODLIB/logs

# Main Log File
MAIN_LOG=$PRODLIB/logs/EDAG_General_`date +%Y%m%d_%H%M%s`.log

# Working Log For Main Extraction
WORK_LOG=$PRODLIB/logs/EDAG_Work_`date +%Y%m%d_%H%M%s`.log

# Setup Log FIle
SETUP_LOG=$PRODLIB/logs/EDAG_Setup_`date +%Y%m%d_%H%M%s`.log

# Working Log For Setup Script
SETUP_WORK_LOG=$PRODLIB/logs/EDAG_Setup_Work_`date +%Y%m%d_%H%M%s`.log

# Directory To Place Output Files For Connect Direct Transfer To EDAG Team
EDAG_CDTRANSFER_DIR=/cdtransfer/PBISG/PBISG/EDA



# Directory To Retrieve QLIK Files For Connect Direct Transfer To EDAG Team
QLIK_CDTRANSFER_DIR=$CDXFER_DIR/PBD/GDW/out/



timestamp() {
TIMESTAMP=`date +%y%m%d.%H%M%S`
}
